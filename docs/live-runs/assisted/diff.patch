diff --git a/test/account-summary.test.ts b/test/account-summary.test.ts
new file mode 100644
index 0000000..df53723
--- /dev/null
+++ b/test/account-summary.test.ts
@@ -0,0 +1,53 @@
+import { test, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { createApp as createPositions } from '../services/position-service/src/app.ts';
+import { PositionStore } from '../services/position-service/src/store.ts';
+import { createApp as createTrades, type Deps } from '../services/trade-api/src/app.ts';
+import { TradeStore } from '../services/trade-api/src/store.ts';
+import { listen, tempFile } from './helpers.ts';
+
+const positions = createPositions(new PositionStore(tempFile('positions.json')));
+const positionsUrl = await listen(positions);
+const tradeDeps: Deps = { store: new TradeStore(tempFile('trades.json')), positionServiceUrl: positionsUrl };
+const trades = createTrades(tradeDeps);
+const tradesUrl = await listen(trades);
+
+// A trade-api whose position-service is not answering, to exercise the 502 path.
+const orphan = createTrades({ store: new TradeStore(tempFile('orphan.json')), positionServiceUrl: 'http://localhost:1' });
+const orphanUrl = await listen(orphan);
+
+after(() => { positions.close(); trades.close(); orphan.close(); });
+
+const post = (body: unknown) =>
+  fetch(`${tradesUrl}/trades`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
+
+const summary = (base: string, account: string) => fetch(`${base}/accounts/${account}/summary`);
+
+test('the summary returns an account\'s trades together with its positions', async () => {
+  await post({ account: 'ACC-1', security: 'VOD.L', side: 'BUY', quantity: 100 });
+  await post({ account: 'ACC-1', security: 'VOD.L', side: 'SELL', quantity: 40 });
+  await post({ account: 'ACC-2', security: 'BP.L', side: 'BUY', quantity: 5 });
+
+  const res = await summary(tradesUrl, 'ACC-1');
+  assert.equal(res.status, 200);
+  const body = await res.json() as { account: string; trades: unknown[]; positions: Record<string, number> };
+
+  assert.equal(body.account, 'ACC-1');
+  assert.equal(body.trades.length, 2);
+  assert.deepEqual(body.positions, { 'VOD.L': 60 });
+});
+
+test('an unknown account gets empty collections', async () => {
+  const res = await summary(tradesUrl, 'ACC-NOPE');
+  assert.equal(res.status, 200);
+  const body = await res.json() as { account: string; trades: unknown[]; positions: Record<string, number> };
+
+  assert.equal(body.account, 'ACC-NOPE');
+  assert.deepEqual(body.trades, []);
+  assert.deepEqual(body.positions, {});
+});
+
+test('the summary is 502 when position-service is unavailable', async () => {
+  const res = await summary(orphanUrl, 'ACC-1');
+  assert.equal(res.status, 502);
+});
