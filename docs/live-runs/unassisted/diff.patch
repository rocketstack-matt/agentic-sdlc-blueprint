+      const summary = url.pathname.match(/^\/accounts\/([^/]+)\/summary$/);
+      if (req.method === 'GET' && summary) {
+        const account = decodeURIComponent(summary[1]!);
+        // Positions are owned by position-service. trade-api reads them over the modelled
+        // relationship `trade-api-to-position-service`, never from the position store.
+        let positions: Record<string, number>;
+        try {
+          const response = await fetch(`${positionServiceUrl}/positions/${encodeURIComponent(account)}`);
+          if (!response.ok) return send(res, 502, { error: 'position-service is unavailable' });
+          ({ positions } = (await response.json()) as { positions: Record<string, number> });
+        } catch {
+          return send(res, 502, { error: 'position-service is unavailable' });
+        }
+        const trades = store.all().filter((t) => t.account === account);
+        return send(res, 200, { account, trades, positions: positions ?? {} });
