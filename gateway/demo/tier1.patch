diff --git a/test/reconciliation.test.ts b/test/reconciliation.test.ts
new file mode 100644
index 0000000..09fc267
--- /dev/null
+++ b/test/reconciliation.test.ts
@@ -0,0 +1,45 @@
+import { test, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { createApp as createPositions } from '../services/position-service/src/app.ts';
+import { PositionStore } from '../services/position-service/src/store.ts';
+import { createApp as createTrades } from '../services/trade-api/src/app.ts';
+import { TradeStore } from '../services/trade-api/src/store.ts';
+import { listen, tempFile } from './helpers.ts';
+
+// position-service needs trade-api's URL and trade-api needs position-service's: wire them after both are listening.
+const positionStore = new PositionStore(tempFile('positions.json'));
+const deps = { tradeApiUrl: '' };
+const positions = createPositions(positionStore, deps);
+const positionsUrl = await listen(positions);
+const trades = createTrades({ store: new TradeStore(tempFile('trades.json')), positionServiceUrl: positionsUrl });
+const tradesUrl = await listen(trades);
+deps.tradeApiUrl = tradesUrl;
+after(() => { positions.close(); trades.close(); });
+
+const post = (body: unknown) =>
+  fetch(`${tradesUrl}/trades`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
+
+test('SPEC-002: an untouched book reconciles', async () => {
+  await post({ account: 'ACC-7', security: 'VOD.L', side: 'BUY', quantity: 100 });
+  await post({ account: 'ACC-7', security: 'VOD.L', side: 'SELL', quantity: 40 });
+  const body = await (await fetch(`${positionsUrl}/positions/ACC-7/reconciliation`)).json() as { consistent: boolean; stored: Record<string, number>; fromTrades: Record<string, number> };
+  assert.equal(body.consistent, true);
+  assert.deepEqual(body.stored, { 'VOD.L': 60 });
+  assert.deepEqual(body.fromTrades, { 'VOD.L': 60 });
+});
+
+test('SPEC-002: an altered book does not reconcile', async () => {
+  const book = positionStore.read();
+  book['ACC-7']!['VOD.L'] = 61;
+  positionStore.write(book);
+  const body = await (await fetch(`${positionsUrl}/positions/ACC-7/reconciliation`)).json() as { consistent: boolean };
+  assert.equal(body.consistent, false);
+});
+
+test('SPEC-002: 502 when trade-api is unavailable', async () => {
+  const orphan = createPositions(new PositionStore(tempFile('p.json')), { tradeApiUrl: 'http://localhost:1' });
+  const url = await listen(orphan);
+  const res = await fetch(`${url}/positions/ACC-7/reconciliation`);
+  orphan.close();
+  assert.equal(res.status, 502);
+});
