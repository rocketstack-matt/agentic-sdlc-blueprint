{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "$id": "https://rocketstack-matt.github.io/agentic-sdlc-blueprint/trade-capture.architecture.json",
  "unique-id": "trade-capture-architecture",
  "name": "Trade Capture",
  "description": "A deliberately small trade capture system used to demonstrate a governed agentic SDLC.",
  "nodes": [
    {
      "unique-id": "trader",
      "node-type": "actor",
      "name": "Trader",
      "description": "Submits trades and views blotters."
    },
    {
      "unique-id": "trade-capture",
      "node-type": "system",
      "name": "Trade Capture System",
      "description": "Captures trades and maintains positions."
    },
    {
      "unique-id": "trade-api",
      "node-type": "service",
      "name": "Trade API",
      "description": "Accepts and lists trades. Must obtain positions from position-service, never from the position store.",
      "interfaces": [
        {
          "unique-id": "trade-api-http",
          "protocol": "HTTP",
          "env-binding": "TRADE_API_PORT"
        }
      ],
      "metadata": {
        "source-path": "services/trade-api",
        "system-manager": "trade-capture-leads",
        "criticality-tier": 2,
        "data-classification": "internal"
      }
    },
    {
      "unique-id": "position-service",
      "node-type": "service",
      "name": "Position Service",
      "description": "Sole owner of position calculation and of the position store.",
      "interfaces": [
        {
          "unique-id": "position-service-http",
          "protocol": "HTTP",
          "env-binding": "POSITION_SERVICE_URL"
        },
        {
          "unique-id": "position-service-port",
          "protocol": "HTTP",
          "env-binding": "POSITION_SERVICE_PORT"
        }
      ],
      "metadata": {
        "source-path": "services/position-service",
        "system-manager": "risk-tech-leads",
        "criticality-tier": 1,
        "data-classification": "confidential"
      }
    },
    {
      "unique-id": "trade-store",
      "node-type": "database",
      "name": "Trade Store",
      "description": "Record of captured trades.",
      "interfaces": [
        {
          "unique-id": "trade-store-file",
          "env-binding": "TRADE_STORE_PATH"
        }
      ],
      "metadata": {
        "criticality-tier": 2,
        "data-classification": "internal"
      }
    },
    {
      "unique-id": "position-store",
      "node-type": "database",
      "name": "Position Store",
      "description": "Book of record for positions. Confidential.",
      "interfaces": [
        {
          "unique-id": "position-store-file",
          "env-binding": "POSITION_STORE_PATH"
        }
      ],
      "metadata": {
        "criticality-tier": 1,
        "data-classification": "confidential"
      },
      "controls": {
        "sdlc-prev-017-service-dependency": {
          "description": "Only position-service may connect to the position store. SDLC-PREV-017 asks that service dependencies be mapped and kept current with every change; drift-check enforces that the code matches this map (risk SDLC-OP-007). The allowed-sources list goes further than the catalog: see candidate control 1 in docs/CANDIDATE-CONTROLS.md.",
          "requirements": [
            {
              "requirement-url": "https://hub.calm.finos.org/calm/domains/finos-sdlc-common-controls/controls/sdlc-prev-017-service-dependency-control/requirement/versions/1.0.0",
              "config": {
                "control-id": "SDLC-PREV-017",
                "name": "Service Dependency Control",
                "description": "Only position-service may connect to the position store; gates/drift-check.mjs compares every connection found in code with this list.",
                "allowed-sources": [
                  "position-service"
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "relationships": [
    {
      "unique-id": "trader-uses-trade-api",
      "description": "Trader submits and lists trades",
      "relationship-type": {
        "interacts": {
          "actor": "trader",
          "nodes": [
            "trade-api"
          ]
        }
      }
    },
    {
      "unique-id": "trade-api-to-position-service",
      "description": "Apply captured trades, read positions",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "trade-api"
          },
          "destination": {
            "node": "position-service",
            "interfaces": [
              "position-service-http"
            ]
          }
        }
      }
    },
    {
      "unique-id": "trade-api-to-trade-store",
      "description": "Persist captured trades",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "trade-api"
          },
          "destination": {
            "node": "trade-store",
            "interfaces": [
              "trade-store-file"
            ]
          }
        }
      }
    },
    {
      "unique-id": "position-service-to-position-store",
      "description": "Persist positions",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "position-service"
          },
          "destination": {
            "node": "position-store",
            "interfaces": [
              "position-store-file"
            ]
          }
        }
      }
    },
    {
      "unique-id": "trade-capture-composition",
      "relationship-type": {
        "composed-of": {
          "container": "trade-capture",
          "nodes": [
            "trade-api",
            "position-service",
            "trade-store",
            "position-store"
          ]
        }
      }
    }
  ],
  "controls": {
    "sdlc-prev-001-code-review": {
      "description": "Review mode is selected by a deterministic, machine-evaluable policy. The policy inputs come from this architecture: which nodes a change touches, their criticality tier and data classification.",
      "requirements": [
        {
          "requirement-url": "https://hub.calm.finos.org/calm/domains/finos-sdlc-common-controls/controls/sdlc-prev-001-code-review/requirement/versions/1.0.0",
          "config": {
            "control-id": "SDLC-PREV-001",
            "name": "Code Review",
            "description": "Review mode is chosen by a deterministic policy from the tier and classification of the nodes a change touches; gates/review-router.mjs applies the rules below.",
            "author-may-not-review": true,
            "default-mode": "human",
            "rules": [
              {
                "mode": "human",
                "reason": "Control plane: the model, the gates, the agent instructions and the pipeline decide how every other change is governed",
                "paths": [
                  "architecture/",
                  "gates/",
                  "agent/",
                  "AGENTS.md",
                  ".mcp.json",
                  ".github/",
                  "package.json",
                  "package-lock.json"
                ]
              },
              {
                "mode": "human",
                "reason": "Touches a tier 1 or confidential/restricted node",
                "max-criticality-tier": 1,
                "data-classifications": [
                  "confidential",
                  "restricted"
                ]
              },
              {
                "mode": "cognitive",
                "reason": "Touches a tier 2+ node holding internal data, or changes requirements or tests",
                "max-criticality-tier": 4,
                "paths": [
                  "specs/",
                  "test/"
                ]
              },
              {
                "mode": "automated",
                "reason": "Documentation only",
                "paths": [
                  "README.md",
                  "docs/",
                  "labs/",
                  "LICENSE",
                  "NOTICE"
                ]
              }
            ]
          }
        }
      ]
    },
    "sdlc-prev-004-requirements-repository": {
      "description": "Requirements live as version-controlled specs. Every code change names an approved spec, and may only touch the CALM nodes that spec declares.",
      "requirements": [
        {
          "requirement-url": "https://hub.calm.finos.org/calm/domains/finos-sdlc-common-controls/controls/sdlc-prev-004-requirements/requirement/versions/1.0.0",
          "config": {
            "control-id": "SDLC-PREV-004",
            "name": "Requirements Repository",
            "description": "Requirements are version-controlled specs in specs/; gates/spec-check.mjs rejects a change that names no approved spec or touches nodes its spec does not declare.",
            "repository": "specs/",
            "audit-trail": "version-control"
          }
        }
      ]
    },
    "sdlc-prev-012-deployment-gating": {
      "description": "A change is only admissible when every blocking gate passes. Without this the other controls are advisory.",
      "requirements": [
        {
          "requirement-url": "https://hub.calm.finos.org/calm/domains/finos-sdlc-common-controls/controls/sdlc-prev-012-deployment-gating/requirement/versions/1.0.0",
          "config": {
            "control-id": "SDLC-PREV-012",
            "name": "Deployment Gating",
            "description": "A change is admissible only when every blocking gate below passes; gates/run-all.mjs runs them and gates/evidence.mjs records the result.",
            "blocking-gates": [
              "calm-validate",
              "spec-check",
              "drift-check",
              "model-diff",
              "tests",
              "review-router"
            ]
          }
        }
      ]
    },
    "sdlc-prev-014-test-evidence-retention": {
      "description": "Gate and test results are captured as a machine-readable bundle bound to the commit and hashed.",
      "requirements": [
        {
          "requirement-url": "https://hub.calm.finos.org/calm/domains/finos-sdlc-common-controls/controls/sdlc-prev-014-test-evidence/requirement/versions/1.0.0",
          "config": {
            "control-id": "SDLC-PREV-014",
            "name": "Test Evidence Retention",
            "description": "gates/evidence.mjs writes one hashed bundle per change, bound to the commit, branch, pipeline run, spec and architecture hash.",
            "bound-to": [
              "commit-sha",
              "tree-sha",
              "spec-id",
              "architecture-sha256"
            ],
            "format": "application/json"
          }
        }
      ]
    }
  },
  "metadata": {
    "catalog": "https://finos.github.io/sdlc-common-controls/"
  }
}
