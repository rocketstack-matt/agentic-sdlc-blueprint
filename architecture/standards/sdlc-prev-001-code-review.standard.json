{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.calm.finos.org/calm/namespaces/finos.agentic-sdlc/standards/sdlc-prev-001-code-review/versions/1.0.0",
  "title": "Code Review, as enforced by this blueprint",
  "description": "Extends the catalog's SDLC-PREV-001 control requirement with the parameters this blueprint's gates need. The catalog says what; this Standard says what our enforcement reads.",
  "allOf": [
    {
      "$ref": "https://hub.calm.finos.org/calm/domains/finos-sdlc-common-controls/controls/sdlc-prev-001-code-review/requirement/versions/1.0.0"
    }
  ],
  "properties": {
    "author-may-not-review": {
      "const": true,
      "description": "The author of a change never satisfies its review requirement"
    },
    "default-mode": {
      "enum": [
        "human",
        "cognitive",
        "automated"
      ],
      "description": "Review mode when no rule matches: fail safe"
    },
    "rules": {
      "type": "array",
      "description": "Evaluated in order by gates/review-router.mjs; the first match decides the mode",
      "items": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "human",
              "cognitive",
              "automated"
            ]
          },
          "reason": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "max-criticality-tier": {
            "type": "integer"
          },
          "data-classifications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "mode",
          "reason"
        ]
      }
    }
  },
  "required": [
    "author-may-not-review",
    "default-mode",
    "rules"
  ]
}
